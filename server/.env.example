PORT=5000
# MongoDB Atlas Connection URI:
# Use standard seedlist format to avoid DNS SRV resolution issues on Windows/restricted networks:
# mongodb://username:URL_ENCODED_PASSWORD@shard0:27017,shard1:27017,shard2:27017/chatboat?ssl=true&replicaSet=atlas-r838qu-shard-0&authSource=admin&appName=Cluster0
MONGO_URI=mongodb://127.0.0.1:27017/chatboat
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=production

# Email Service (Gmail or standard SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="ChatBoat" <your_email@gmail.com>

# Or Custom SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp_username
# SMTP_PASS=smtp_password
